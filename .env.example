# Onyx backend — environment template. Copy to .env for local dev.
# NEVER commit a real .env, and NEVER paste a real secret into this file.
# All values here are placeholders.

# --- Database (Supabase, free tier) -------------------------------------
# Leave blank for local dev: the server falls back to local SQLite.
SUPABASE_URL=
SUPABASE_KEY=

# --- Local dev only -------------------------------------------------------
# ONYX_DB_PATH=onyx_dev.db

# --- Admin (verify endpoint) ----------------------------------------------
# Simple env-var key for now. Real admin auth must replace this before launch.
ADMIN_KEY=change-me-to-a-long-random-string

# --- Premium / payments ---------------------------------------------------
PREMIUM_PRICE_USDT=1.97
PREMIUM_DAYS=30
FREE_DAILY_LIMIT=10
# Checkout stays OFF until real wallet addresses are set. The flag lives
# in the Supabase `settings` table (key `checkout_enabled`), NOT in env:
#   update settings set value='true' where key='checkout_enabled';
# Flip it only on the owner's word, after the real addresses are in.
# Real USDT wallet addresses — set in Render env vars / Supabase settings,
# NEVER in this file or in git. Placeholders live in schema.sql settings.
WALLET_BSC=
WALLET_TRON=

# --- Optional TXID auto-check (default manual; opt-in only) ---------------
AUTO_TXID_CHECK=false
BSCSCAN_API_KEY=

# --- Telegram bot (webhook only — no polling) ------------------------------
# The bot token goes ONLY in Render env vars, never in chat or code.
# Without it, POST /telegram/webhook returns 503 and nothing else breaks.
TELEGRAM_BOT_TOKEN=
# Optional but recommended: set the same value in setWebhook's secret_token
# so the webhook rejects POSTs that did not come from Telegram (401).
TELEGRAM_WEBHOOK_SECRET=

# --- Quotex demo account (Way 1 feed — engine agent's area) ---------------
# Login/session go ONLY in Render env vars, never in chat or code.
QUOTEX_EMAIL=
QUOTEX_PASSWORD=

# --- CORS -----------------------------------------------------------------
# Comma-separated extra origins beyond GitHub Pages + Telegram + localhost.
ALLOWED_ORIGINS=
